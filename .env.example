# Copy to .env and fill in. Leave a key blank to disable that feed.
# Never commit .env.

# NASA FIRMS (fires)
FIRMS_API_KEY=

# OpenSky Network (flights)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO (satellites)
N2YO_API_KEY=

# AIS vessel data
AIS_API_KEY=

# Osiris image tag for docker-compose.yml. Required there (not a feed key): set a reviewed
# release tag or digest, e.g. v1.2.3 or v1.2.3@sha256:... . Blank means compose will not start.
OSIRIS_IMAGE_TAG=

# Intentionally omitted: SCANNER_URL / SCANNER_KEY.
# RECON scanning (port/vuln scan) is disabled for this deployment.
